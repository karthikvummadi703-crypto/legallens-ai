# FastAPI Backend Environment Settings
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Google Gemini API Keys (server-side AI processing)
# Add up to 3 keys: the backend rotates through them and automatically fails
# over to the next key when one hits its quota/rate limit.
GEMINI_API_KEY=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here
# Alternative: comma-separated list (combined with the above, deduped).
# GEMINI_API_KEYS=key1,key2,key3

# Firebase Admin Service Account Path (Required for secure auth)
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

# --- Cloud / Vercel serverless persistence (optional) ---
# When deploying on Vercel the filesystem is read-only & ephemeral, so the
# backend switches to Firebase Realtime Database + Firebase Cloud Storage.
# Two ways to enable it:
#   1. Set STORAGE_BACKEND=cloud (recommended), or
#   2. It engages automatically whenever the VERCEL env var is present.
# Provide the service account as RAW JSON CONTENT in an env var (serverless
# has no file besides your bundle) plus these two settings:
# STORAGE_BACKEND=cloud
# FIREBASE_SERVICE_ACCOUNT_JSON_CONTENT={"type": "service_account", ...}
# FIREBASE_DATABASE_URL=https://my-project-495811-default-rtdb.firebaseio.com
# FIREBASE_STORAGE_BUCKET=my-project-495811.firebasestorage.app

# Auth mode: "auto" (default) | "dev" | "off"
# - "auto": strict token verification when Firebase is configured; fixed dev
#   user ONLY when no service account is present (local dev out of the box).
# - "dev": always accept the fixed dev user (local development ONLY).
# - "off": strict mode, unauthenticated/invalid requests are rejected.
# NEVER use "dev" in production. On Vercel, "auto" fails closed when Firebase
# is misconfigured (no dev fallback is ever granted on serverless).
AUTH_DEV_MODE=auto

# Optional rate limiting (requests per IP per window)
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
